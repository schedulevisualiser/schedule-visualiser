# --- Real / confidential schedule exports ---
# Kept on your machine only, never recorded in git history, so they can't be
# accidentally uploaded if you ever share this project online. The app still
# reads them straight from the sample/ folder as normal.
# Rule: NO .xer in sample/ is tracked except the synthetic demo file, which
# contains no real data.
/sample/*.xer
!/sample/Sample_Project.xer
*.pdf

# --- Machine-specific Claude Code settings ---
.claude/settings.local.json

# --- OS / editor junk ---
Thumbs.db
Desktop.ini
.DS_Store
*~
